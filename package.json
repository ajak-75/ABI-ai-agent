{
  "name": "android-ai-agent",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "description": "PHASE 1 — local-first Android AI agent shell (Expo + React Native + TypeScript, SQLite memory, approval/audit surface). No model or network calls yet.",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo start --dev-client --android",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "config": "expo config --type public",
    "prebuild:android": "expo prebuild --platform android",
    "build:apk:eas": "npx eas-cli build --platform android --profile development",
    "build:apk:local": "npx eas-cli build --platform android --profile development --local",
    "build:aab:eas": "npx eas-cli build --platform android --profile production",
    "test": "bash scripts/run-tests.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
